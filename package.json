{
  "name": "click-down",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"node --watch server/index.mjs\" \"vite --host 127.0.0.1\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "node --watch server/index.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node server/index.mjs",
    "test": "tsx --test server/integration.test.mjs tests/ui.test.tsx"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "express": "^5.3.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.7",
    "jsdom": "^29.1.1",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
